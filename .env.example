AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://bookkeeper-api
# Client ID of the Auth0 "Single Page Application" (used by the browser)
AUTH0_CLIENT_ID=your-spa-client-id
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/bookkeeper
# Tests write data here. Use a throwaway database, never production.
TEST_MONGODB_URI=mongodb://localhost:27017/bookkeeper_test
PORT=3000
LOG_LEVEL=info
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
